{
  "name": "@lpshanley/oidc-start-core",
  "version": "0.4.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpshanley/oidc-start.git",
    "directory": "packages/core"
  },
  "description": "OpenID Connect sign-in, grants and sessions for Node.js",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-package": "publint --strict"
  },
  "dependencies": {
    "iron-webcrypto": "catalog:",
    "jose": "catalog:",
    "openid-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "publint": "catalog:",
    "@types/node": "catalog:"
  }
}
